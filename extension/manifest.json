{
  "manifest_version": 3,
  "name": "Omrum URL Reporter",
  "version": "0.1.0",
  "description": "Reports the active tab URL to a local Omrum daemon for time tracking.",
  "permissions": ["tabs", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:7942/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "omrum@local"
    }
  }
}
